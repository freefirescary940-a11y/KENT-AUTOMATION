# Copy this file to ".env" and change the values
PORT=3000
JWT_SECRET=put-a-long-random-text-here
ADMIN_ID=gnane
# Used only the first time. Change it later in Setup -> Admin login
ADMIN_PASSWORD=9032

# Free permanent storage (Neon / Supabase Postgres). Paste the connection string here. Leave empty to use files.
DATABASE_URL=

# ---- Admin login by e-mail + OTP (leave empty to keep ID + password login) ----
ADMIN_EMAIL=paidignane708@gmail.com
# Pick ONE mail provider. On Render FREE use Brevo or Resend (SMTP is blocked there).
MAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
# SMTP (paid hosts / your PC only): Gmail needs an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Emergency: set to 1 to switch OTP off and use ID + password again
ADMIN_OTP_DISABLE=
